{
  "manifest_version": 3,
  "name": "FavFontz",
  "version": "1.0.0",
  "description": "Save your favorite Google Fonts and keep them in one list.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FavFontz",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://fonts.google.com/*",
    "https://fonts.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fonts.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
